# Auroranexis environment template (Mollie sole billing provider)
# Copy to .env.local for development. Never commit real secrets.
# Mollie is the sole active billing/checkout provider.
# Do not configure retired Stripe / Paddle / FastSpring provider credentials —
# they are unused at runtime. Historical billing_provider rows may remain in the DB.

# Supabase — public (browser + server with RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — server only (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application URL for auth redirects (per environment)
# Local: http://localhost:3000
# Staging: https://staging.auroranexis.com
# Production: https://app.auroranexis.com (or https://www.auroranexis.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron — server only (POST /api/cron/run)
CRON_SECRET=your-cron-bearer-secret

# Integration secrets vault — server only (64-char hex recommended)
INTEGRATION_SECRET_KEY=your-64-char-hex-integration-secret-key

# Email — server only (report delivery / notifications / welcome)
# Native STRATO SMTP is the production path. SMTP_PASSWORD is operator-supplied
# in Vercel Production — never commit the mailbox password.
# Transactional From must be Auroranexis <noreply@auroranexis.com> (never sales@).
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.strato.de
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Preferred explicit platform From (overrides RESEND_FROM_EMAIL when set)
EMAIL_FROM=Auroranexis <noreply@auroranexis.com>

# Optional Resend (unused when EMAIL_PROVIDER=smtp)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Auroranexis <noreply@auroranexis.com>

# Mollie — sole active checkout/billing provider
# Server only, never NEXT_PUBLIC_. Prefix test_ (TEST) or live_ (LIVE).
# Payment writes: TEST keys always; LIVE requires MOLLIE_LIVE_CHARGING_ENABLED=true.
# Classic webhook URL only: https://your-domain.com/api/mollie/webhook (payment notifications + API re-fetch)
# Do NOT configure Next-Gen Dashboard webhooks / X-Mollie-Signature for this integration.
# MOLLIE_API_KEY=
# Rollout on = all orgs eligible for NEW Mollie checkout.
# MOLLIE_BILLING_ROLLOUT=true
# Optional emergency partial enable while rollout is off (comma-separated org UUIDs)
# MOLLIE_BILLING_ORG_ALLOWLIST=
# Retained for diagnostics; with rollout on, default-for-new is implied.
# MOLLIE_BILLING_DEFAULT_FOR_NEW=false
# LIVE kill switch — independent from rollout. Must remain false until explicit go-live approval.
# MOLLIE_LIVE_CHARGING_ENABLED=false

# AI — server only (never use NEXT_PUBLIC prefix)
AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
# Kill-switch: AI_PROVIDER=disabled

# Connector OAuth — server only (configure per provider used)

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
ZENDESK_CLIENT_ID=
ZENDESK_CLIENT_SECRET=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=

# E2E only — set by Playwright webServer; never enable in production
# E2E_DISABLE_RATE_LIMIT=1

# E2E — Playwright authenticated flows
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
# Legacy aliases
E2E_EMAIL=
E2E_PASSWORD=

# Pilot seed — optional
PILOT_SEED_PASSWORD=

# Observability — optional (see docs/observability.md)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
# Search Console / Bing Webmaster — paste verification tokens from each console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
# IndexNow — server-only key for Bing/participating engines (served at /.well-known/{INDEXNOW_KEY}.txt)
INDEXNOW_KEY=

# Local development only — ignored when NODE_ENV=production
# DEV_FORCE_PLAN=professional

# Retired Stripe / Paddle / FastSpring credentials must not be configured.
# Historical stripe_* / paddle_* / provider_* columns remain archive-only in the database.
